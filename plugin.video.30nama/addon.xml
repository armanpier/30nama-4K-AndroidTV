<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.30nama" name="30nama 4K (Android TV)" version="1.0.5" provider-name="CustomTV">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="script.module.requests" version="2.25.1"/>
    </requires>
    <extension point="xbmc.python.pluginsource" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" start="startup"/>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">30nama 4K Direct Download Streamer with Auto Persian/English Subtitles</summary>
        <description lang="en_GB">Streams 4K direct download MKV/MP4 links and 2160p stream profiles on Android TV with automatic Persian (UTF-8 fixed) and English subtitle extraction.</description>
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
        </assets>
    </extension>
</addon>
